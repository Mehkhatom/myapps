{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myapps",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "86ce53e7-21c4-4b1e-b75f-777c4f65f56e","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0c0f6bd90294441fa7c482d07974a2e8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
